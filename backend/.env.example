# Server & OIDC Issuer Configuration
PORT=4000
HOST=0.0.0.0
OIDC_ISSUER=https://auth.soauth.internal
FRONTEND_LOGIN_URL=https://login.soauth.internal

# PostgreSQL Connection
DATABASE_URL=postgres://soauth_user:soauth_pass@localhost:5432/soauth_db

# Redis Connection (Short-lived Auth Codes & Replay Detection)
REDIS_URL=redis://localhost:6379/0

# Cryptographic Key Configuration (RS256 or ES256)
SIGNING_ALG=RS256
KEY_ID=soauth-key-2026-10
