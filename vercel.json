{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm --prefix backend install && npm --prefix frontend install",
  "buildCommand": "npm --prefix backend run build && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/authorize", "destination": "/api/index" },
    { "source": "/token", "destination": "/api/index" },
    { "source": "/userinfo", "destination": "/api/index" },
    { "source": "/revoke", "destination": "/api/index" },
    { "source": "/introspect", "destination": "/api/index" },
    { "source": "/logout", "destination": "/api/index" },
    { "source": "/register", "destination": "/api/index" },
    { "source": "/callback", "destination": "/api/index" },
    { "source": "/.well-known/:path*", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
